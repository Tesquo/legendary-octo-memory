# Frontend settings, read from Vite env vars at build time.
#
# Copy this to `.env.local` for development, or set the same names in your static
# host's build environment for a deployment. Every value is optional; the
# commented defaults are what the app falls back to. See README.md
# § "Deploying the frontend (static site)" and § "TURN relay".

# Where the Go API lives. Keep the default for the host's own machine — a viewer
# never calls the API, so this value only matters to the host.
# VITE_API_BASE=http://localhost:8080

# Initial playback volume, 0..1.
# VITE_DEFAULT_VOLUME=0.3

# "true" to attempt playback as soon as a video opens.
# VITE_AUTOPLAY=true

# Absolute base path the app is served from. Only set this for a host that
# serves the app under a sub-path, e.g. a GitHub Pages project site:
#   VITE_BASE=/legendary-octo-memory/
# Leave it unset for the dev server and for hosts at the domain root (Netlify,
# Vercel, Cloudflare Pages). Read at build time by vite.config.js — it is not a
# browser setting, so do not put it in a local `.env.local`.
# VITE_BASE=/

# ICE servers for the peer connection, as a JSON array of RTCIceServer objects.
# The default is public STUN only; add a TURN relay to connect the ~10-20% of
# viewer pairs that STUN alone cannot reach. Keep it on one line.
# VITE_ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"},{"urls":"turn:turn.example.com:3478","username":"user","credential":"pass"}]
